{
  "name": "eleventy-template-multiplicity",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "prebuild": "npm run clean",
    "build:eleventy": "eleventy --quiet",
    "build": "npm-run-all build:*",
    "postbuild": "npm run minify:js",
    "minify:js": "node ./build-scripts/minify",
    "watch:eleventy": "eleventy --serve --port=8080 --quiet",
    "watch:sass": "sass --no-source-map --watch ./styles:_site/css --style compressed",
    "build:sass": "sass --no-source-map styles:_site/css --style compressed",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier .",
    "format:fix": "prettier . --write",
    "clean": "rimraf _site .cache",
    "predev": "npm run clean",
    "dev": "ELEVENTY_ENV=development npm-run-all build:sass --parallel watch:*",
    "debug": "DEBUG=Eleventy* npm run dev",
    "start": "npm run dev"
  },
  "dependencies": {
    "@11ty/eleventy": "3.1.6",
    "@11ty/eleventy-fetch": "5.1.3",
    "@extractus/feed-extractor": "8.0.3",
    "cli-color": "^2.0.4",
    "eleventy-plugin-gen-favicons": "^1.1.3",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "image-type": "6.1.0",
    "is-svg": "6.1.0",
    "luxon": "3.7.2",
    "minify-xml": "^4.5.2",
    "npm-run-all2": "9.0.3",
    "sass": "1.105.1",
    "sharp": "0.35.5",
    "slugify": "^1.6.6",
    "string-strip-html": "13.7.7",
    "terser": "5.51.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "rimraf": "6.1.3"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.14.0"
  },
  "packageManager": "npm@11.14.0",
  "overrides": {
    "eleventy-plugin-gen-favicons": {
      "sharp": "$sharp"
    }
  }
}
